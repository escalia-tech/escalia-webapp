# Dependencies and build output (rebuilt inside the image)
node_modules
.next
out
dist
coverage
.nyc_output

# Version control and IDE
.git
.gitignore
.github
.vscode
.idea
*.iml
.DS_Store

# Local env and generated compose env (never bake secrets)
.env
.env.*
!.env.example
.env.compose

# Agent tooling, skills, MCP — not required at runtime
.agents
.claude
.cursor
.mcp.json
.cursor/

# Tests and reports
tests
playwright-report
test-results
.playwright-mcp
**/*.spec.ts
**/*.test.ts

# Docs (except branding reference imported at build time)
docs/**
!docs/branding/references/**

# Deployment artefacts from local experiments
*.oci.tar
dist/*.oci.tar

# Misc caches / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo