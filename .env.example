# Escalia WebApp — environment variables (copy to .env.local, never commit real values).
# Validated at startup by src/server/config/env.ts. No secret belongs in a NEXT_PUBLIC_* variable.

# --- Runtime environment ---------------------------------------------------------------
# local | development | test | staging | production
# Defaults to "production" when NODE_ENV=production and to "local" otherwise.
APP_ENV=local
# Public origin of the application (used for Origin checks on BFF mutations and metadata).
APP_URL=http://localhost:3000

# --- Demo mode (fixtures, demo session entry, component gallery) -----------------------
# Honoured ONLY when APP_ENV is local, development or test. Production refuses it even when "true".
DEMO_MODE_ENABLED=true
# HMAC secret of the demo session cookie. Optional in local/dev (an ephemeral per-process secret is
# generated), REQUIRED when demo mode runs under APP_ENV=test with several processes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEMO_SESSION_SECRET=

# --- Observability ---------------------------------------------------------------------
# trace | debug | info | warn | error | fatal  (default: debug in local, info otherwise)
LOG_LEVEL=debug
# pretty | json  (default: pretty in local, json otherwise)
LOG_FORMAT=pretty
# Browser logger level and kill switch (browser logs are never sent remotely by default).
NEXT_PUBLIC_CLIENT_LOGGING_ENABLED=false
CLIENT_LOG_LEVEL=warn
# OpenTelemetry. Remote export stays OFF until a destination is approved.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=escalia-webapp

# --- BFF ------------------------------------------------------------------------------
# Upstream timeout used by the BFF service layer (milliseconds).
BFF_UPSTREAM_TIMEOUT_MS=5000
