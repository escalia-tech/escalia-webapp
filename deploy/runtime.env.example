# Runtime applicatif (équivalent ConfigMap Kubernetes) — copier vers deploy/runtime.env et adapter.
# Les secrets (DEMO_SESSION_SECRET, etc.) vont dans un Secret / fichier séparé, pas dans compose.yaml.
# NEXT_PUBLIC_* est figé au build de l'image ; ces lignes n'agissent pas sur une image déjà construite.
# Schéma : src/server/config/env.ts — liste complète : .env.example

NODE_ENV=production
APP_ENV=staging

# Démo activée par défaut hors production réelle ; mettre false pour la couper.
# DEMO_MODE_ENABLED=false
# DEMO_SESSION_SECRET=

LOG_LEVEL=info
LOG_FORMAT=json
CLIENT_LOG_LEVEL=warn
OTEL_ENABLED=false
OTEL_SERVICE_NAME=escalia-webapp
BFF_UPSTREAM_TIMEOUT_MS=5000